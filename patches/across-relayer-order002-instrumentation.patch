+  /** Populate and serialize an unsigned transaction without signing or submitting it. */
+  async prepare(txn: AugmentedTransaction): Promise<{ serialized: string }> {
+    const { contract, method, args, value = bnZero, gasLimit } = txn;
+    const populated =
+      method === ""
+        ? { to: contract.address, data: args[0] as ethers.utils.BytesLike, value }
+        : await contract.populateTransaction[method](...args, { value });
+    if (isDefined(gasLimit)) populated.gasLimit = gasLimit;
+    const complete = await contract.signer.populateTransaction(populated);
+    const { from: _from, ...unsigned } = complete;
+    return { serialized: ethers.utils.serializeTransaction(unsigned) };
+  }
