+  /** Populate and serialize an unsigned transaction without signing or submitting it. */
+  async prepare(txn: AugmentedTransaction): Promise<{ serialized: string }> {
+    const { contract, method, args, value = bnZero, gasLimit } = txn;
+    const populated: ethers.providers.TransactionRequest =
+      method === ""
+        ? { to: contract.address, data: args[0] as ethers.utils.BytesLike, value }
+        : await contract.populateTransaction[method](...args, { value });
+    if (isDefined(gasLimit)) populated.gasLimit = gasLimit;
+
+    const complete = await contract.signer.populateTransaction(populated);
+    let nonce: number | undefined;
+    if (isDefined(complete.nonce)) {
+      const resolvedNonce = BigNumber.from(complete.nonce);
+      assert(
+        resolvedNonce.lte(Number.MAX_SAFE_INTEGER.toString()),
+        "Across-Edge cannot serialize transaction: nonce exceeds JS safe integer range"
+      );
+      nonce = resolvedNonce.toNumber();
+    }
+
+    const unsigned: ethers.utils.UnsignedTransaction = {
+      to: complete.to,
+      nonce,
+      gasLimit: complete.gasLimit,
+      gasPrice: complete.gasPrice,
+      data: complete.data,
+      value: complete.value,
+      chainId: complete.chainId,
+      type: complete.type,
+      accessList: complete.accessList,
+      maxPriorityFeePerGas: complete.maxPriorityFeePerGas,
+      maxFeePerGas: complete.maxFeePerGas,
+    };
+    return { serialized: ethers.utils.serializeTransaction(unsigned) };
+  }
